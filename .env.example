# =====================================================================
#  Vigiz — ortam değişkenleri
#  Kopyala: cp .env.example .env.local  (.env.local asla commitlenmez)
# =====================================================================

# --- Public (tarayıcıya açık) ---
# NEXT_PUBLIC_* ile başlayan her değer tarayıcıda görünür. Sır koyma.
NEXT_PUBLIC_SUPABASE_URL=https://dummy.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_dummy

# --- Sunucu (asla NEXT_PUBLIC yapma) ---
SUPABASE_SECRET_KEY=sb_secret_dummy
ADMIN_PASSWORD=dummy-password
# Host oturum cookie'sini imzalamak için rastgele uzun bir değer (openssl rand -hex 32)
ADMIN_COOKIE_SECRET=dummy-random-32-chars
